rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() { return request.auth != null; }
    function isOwner(uid) { return isSignedIn() && request.auth.uid == uid; }

    match /users/{uid} {
      allow read, write: if isOwner(uid);

      match /recipes/{recipeId} {
        allow read: if isOwner(uid);
        allow create: if isOwner(uid) && request.resource.data.ownerId == uid;
        allow update, delete: if isOwner(uid) && resource.data.ownerId == uid;
      }

      match /meta/{docId} {
        allow read, write: if isOwner(uid);
      }
    }

    // Public library of shared recipes. Authenticated-only reads for now (not fully
    // public) to keep read/quota exposure limited to real accounts -- easy to relax
    // later if a public share-link feature is wanted.
    match /sharedRecipes/{sharedId} {
      allow read: if isSignedIn();
      // Only Cloud Functions (Admin SDK, bypasses rules) may write -- never a direct
      // client write, even from the recipe's own owner -- so the public copy's shape
      // can never drift from what shareRecipe/unshareRecipe validated.
      allow write: if false;
    }
  }
}
