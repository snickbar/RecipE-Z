rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Recipe photos (main/step/note images) live under the owning user's own uid,
    // regardless of whether that recipe is later shared -- a shared/imported recipe
    // just reuses the same download URL rather than duplicating the file.
    match /users/{uid}/recipes/{recipeId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid
                   && request.resource.size < 10 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }
  }
}
